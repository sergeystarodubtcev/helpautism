		<link>https://helpautism.ru/2012/04/17/nekotoryie-eticheskie-aspektyi-pomoshhi-d/</link>
		<pubDate>Tue, 17 Apr 2012 15:13:16 +0000</pubDate>
		<dc:creator><![CDATA[helpaut]]></dc:creator>
