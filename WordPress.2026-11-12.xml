<figure class="wp-block-image size-large"><img src="https://helpautism.ru/wp-content/uploads/2025/10/img_0163-1024x683.jpg" alt="" class="wp-image-8534"/></figure>
<!-- /wp:image -->

<!-- wp:image {"id":8535,"sizeSlug":"large","linkDestination":"none"} -->
<figure class="wp-block-image size-large"><img src="https://helpautism.ru/wp-content/uploads/2025/10/img_9695-683x1024.jpg" alt="" class="wp-image-8535"/></figure>
<!-- /wp:image -->

<!-- wp:image {"id":8532,"sizeSlug":"large","linkDestination":"none"} -->
<figure class="wp-block-image size-large"><img src="https://helpautism.ru/wp-content/uploads/2025/10/img_9573-1024x683.jpg" alt="" class="wp-image-8532"/></figure>
<!-- /wp:image -->

<!-- wp:image {"id":8531,"sizeSlug":"large","linkDestination":"none"} -->
<figure class="wp-block-image size-large"><img src="https://helpautism.ru/wp-content/uploads/2025/10/img_9646-683x1024.jpg" alt="" class="wp-image-8531"/></figure>
