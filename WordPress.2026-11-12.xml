<!-- wp:image {"id":8196,"sizeSlug":"large","linkDestination":"none"} -->
<figure class="wp-block-image size-large"><img src="https://helpautism.ru/wp-content/uploads/2025/06/img-20250422-wa0040-768x1024.jpg" alt="" class="wp-image-8196"/></figure>
<!-- /wp:image -->

<!-- wp:image {"id":8193,"sizeSlug":"large","linkDestination":"none"} -->
