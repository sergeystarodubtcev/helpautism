		<title><![CDATA[Аня и мир. В Воронеже формируется культура инклюзивного образования]]></title>
		<link>https://helpautism.ru/2013/06/27/anya-i-mir-v-voronezhe-formiruetsya-kult/</link>
		<pubDate>Thu, 27 Jun 2013 11:00:30 +0000</pubDate>
		<dc:creator><![CDATA[helpaut]]></dc:creator>
