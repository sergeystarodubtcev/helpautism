		<content:encoded><![CDATA[.logo-link{
	display:flex;
	margin-left:10px;
	max-width:fit-content;
}

.not-btn{
	padding:0 !important;
	background-color: transparent;
  color: #2a86c7;
  text-transform: none;
  font-family: inherit;
  cursor: pointer;
  font-size: 16px;
}

.not-btn:hover{
	background-color:unset !important;
	color:#2a86c7 !important;
}
.logo-link:hover{
	background-color:#2a86c7 !important;
	opacity: 0.6;
  transition: all 700ms;
	
}

.p-no-margin, .logo-link{
	margin-bottom:2px !important;
}
@media(max-width:1476px){
#menu-verxnee-menyu li{
	padding:0px;
}
}
.navbar-inverse .navbar-nav>li>a{
	padding-top:16px !important;
}
.menu-align-center #site-navigation{
	width:45% !important;
}]]></content:encoded>
