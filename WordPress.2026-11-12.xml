<!-- wp:image {"id":8232,"width":791,"height":444,"sizeSlug":"large","linkDestination":"none"} -->
<figure class="wp-block-image size-large is-resized"><img src="https://helpautism.ru/wp-content/uploads/2025/06/ei_lqeflcj8-edited.jpg" alt="" class="wp-image-8232" width="791" height="444"/></figure>
